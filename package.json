{
  "name": "airlink-monorepo",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "AirLink: Open-Source Coding Agent Universal Remote Control",
  "scripts": {
    "build": "pnpm -r run build",
    "postinstall": "node -e \"if (require('fs').existsSync('packages/protocol/src')) require('child_process').execSync('pnpm --filter @airlink/protocol build', { stdio: 'inherit' })\"",
    "eas-build-post-install": "pnpm --filter @airlink/protocol build",
    "start": "pnpm --filter @airlink/relay start",
    "typecheck": "pnpm build && pnpm -r run typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm build && vitest run",
    "test:coverage": "pnpm build && vitest run --coverage",
    "check:suppressions": "node scripts/check-suppressions.mjs",
    "dev:relay": "pnpm --filter @airlink/relay dev",
    "dev:cli": "pnpm --filter @airlink/cli dev",
    "dev:mobile": "pnpm --filter @airlink/mobile start",
    "dev:web": "pnpm --filter @airlink/web dev",
    "build:cli": "pnpm --filter @airlink/cli build",
    "publish:cli": "pnpm build:cli && pnpm --filter @airlink/cli publish --access public --no-git-checks"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.24.0",
    "vitest": "^2.0.5",
    "@vitest/coverage-v8": "^2.0.5"
  },
  "packageManager": "pnpm@9.7.0"
}
