
# Relay & Network Server Settings
PORT=3001
RELAY_URL=http://localhost:3001

# Primary Engine API Key (Google AI Studio)
# Obtain from https://aistudio.google.com/app/apikey
# If left blank, the harness defaults seamlessly to the local 0x-alpha engine mode.
GEMINI_API_KEY=

# ⚙️ Active Default Engine Model
# Default options: gemini-2.0-flash, gemini-1.5-flash, or 0x-alpha
AGENT_MODEL=gemini-2.0-flash
