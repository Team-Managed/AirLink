{
  "name": "@agent-remote/relay",
  "version": "0.1.0",
  "description": "Stateless Socket.io cloud relay message bridge for remote coding agent control",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "dev": "node dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@agent-remote/protocol": "workspace:*",
    "dotenv": "^16.4.5",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "socket.io-client": "^4.7.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
