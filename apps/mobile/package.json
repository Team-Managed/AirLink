{
  "name": "@airlink/mobile",
  "version": "0.1.0",
  "description": "Cross-platform React Native Expo mobile control client for AirLink with pairing, live streaming, diff card, and approval drawer",
  "main": "index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "start": "expo start",
    "eas-build-post-install": "pnpm --filter @airlink/protocol build",
    "build:apk": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "build:all": "eas build --platform all --profile preview"
  },
  "dependencies": {
    "@airlink/protocol": "workspace:*",
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.4",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
