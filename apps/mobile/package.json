{
  "name": "@airlink/mobile",
  "version": "0.1.0",
  "description": "Cross-platform React Native Expo mobile control client for AirLink with pairing, live streaming, diff card, and approval drawer",
  "main": "index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "start": "expo start"
  },
  "dependencies": {
    "@airlink/protocol": "workspace:*",
    "@expo/metro-runtime": "^6.1.2",
    "expo": "~54.0.27",
    "expo-secure-store": "~14.0.1",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.10",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
