{
  "name": "@airlink/cli",
  "version": "0.1.0",
  "description": "AirLink interactive terminal CLI host and client for remote coding agent control",
  "type": "module",
  "bin": {
    "airlink": "dist/bin.cjs",
    "agent-remote": "dist/bin.cjs"
  },
  "files": [
    "dist/bin.cjs",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "dev": "node dist/bin.cjs"
  },
  "devDependencies": {
    "@airlink/bridge-core": "workspace:*",
    "@airlink/protocol": "workspace:*",
    "@types/node": "^22.0.0",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}